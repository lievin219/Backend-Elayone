# Copy this file to .env in this directory and replace the placeholders.
# Keep .env private; never commit database credentials, JWT secrets, or mail passwords.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173"

# Initial administrator account used by the seed command.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Gmail SMTP example. Use a Google App Password, not the normal account password.
# Remove RESEND_API_KEY from the backend environment when using Gmail SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-full-gmail-address@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="Elayone Music <your-full-gmail-address@gmail.com>"
FRONTEND_URL="https://app.elayonemusic.org"

# Needed only for song uploads to Supabase Storage.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="replace-with-your-server-only-supabase-secret-key"
SUPABASE_SONGS_BUCKET="song-media"
