{
  "name": "elayone-choir-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "postinstall": "prisma generate",
    "predev": "npm run db:generate",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "start": "node dist/index.js",
    "db:generate": "node -r dotenv/config ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:create": "tsx src/create-database.ts",
    "db:validate": "node -r dotenv/config ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "db:migrate": "node -r dotenv/config ./node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node -r dotenv/config ./node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:status": "node -r dotenv/config ./node_modules/prisma/build/index.js migrate status --schema prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@supabase/server": "^1.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
